# =========================================================
# SIGNAFLOW ENVIRONMENT CONFIGURATION (.env.example)
# Salin file ini menjadi .env: cp .env.example .env
# =========================================================

# 1. PostgreSQL Database
POSTGRES_USER=signaflow
POSTGRES_PASSWORD=signaflow_secret_2026
POSTGRES_DB=signaflow_db
DATABASE_URL="postgresql://signaflow:signaflow_secret_2026@localhost:5432/signaflow_db?schema=public"

# 2. Authentication & Security
JWT_SECRET="ganti_dengan_64_karakter_acak_untuk_produksi_signaflow_2026_pkl"
ADMIN_SEED_EMAIL="admin@signaflow.local"
ADMIN_SEED_PASSWORD="AdminSignaFlow2026!"

# 3. Media Storage & Venue Timezone
STORAGE_DRIVER="local"
MEDIA_UPLOAD_DIR="./uploads"
PUBLIC_MEDIA_BASE_URL="/media"
VENUE_TIMEZONE="Asia/Jakarta"

# 4. Reverse Proxy / Domain (Caddy)
CADDY_DOMAIN="localhost"
NEXT_PUBLIC_APP_URL="https://localhost"
